// ui.esk: CanvasView for eskiu-lang/ui apps (<canvas/ui>). A GpuView whose canvas is drawn
// once per display frame (use_frame) while `running`, and once each time it is laid out:
//
//     CanvasView(Style{grow: 1}, playing.get(), void(*Canvas canvas, Tick tick) {
//         world_step(&world, tick.delta);
//         canvas.draw_image_rect(&atlas, cell, place, Paint{nearest: true});
//     });
//
// The canvas is in points, like the layout, and is cleared to transparent before each draw.
// Images are made from the canvas the callback gets (canvas.image_decode, image_rgba), the
// first time it runs; the canvas, and what was made from it, lives as long as the view's
// surface (a (0, 0) resize on Android drops it). On iOS and Android it draws with the GPU;
// on the web (and the desktop, which runs the web build) with the browser's Canvas 2D on a
// <canvas> element: the same calls, PNG and JPEG images.

import <io>;
import <mem>;
import <result>;
import <ui>;
import <gpu/ui>;

#if defined(__ANDROID__) || defined(TARGET_OS_IPHONE)
import <gpu/raw>;
import <gpu/core>;
import <gpu/render>;
import <canvas>;
#else
import <string>;
import <canvas>;
#endif

struct _CanvasHost {
    fn(*Canvas, Tick)->void draw;
#if defined(__ANDROID__) || defined(TARGET_OS_IPHONE)
    Gpu gpu;
    bool has_gpu;
    GpuSurface surface;
    bool has_surface;
    Canvas canvas;
    bool has_canvas;
#elif defined(__wasm__)
    Canvas canvas;
    bool has_canvas;
    int view;
#endif
    uint32 width;
    uint32 height;
    float scale;
    string error;
}

void _canvas_release_draw(escaping fn(*Canvas, Tick)->void draw) { free_closure(draw); }

#if defined(__ANDROID__) || defined(TARGET_OS_IPHONE)
void _canvas_drop_surface(*_CanvasHost host) {
    if (host.has_canvas) { host.canvas.release(); host.has_canvas = false; }
    if (host.has_surface) { host.surface.release(); host.has_surface = false; }
}

void _canvas_fail(*_CanvasHost host, string error) {
    free(host.error);
    host.error = ui_copy(error);
    printf("canvas: %s\n", error);
}

bool _canvas_open(*_CanvasHost host) {
    if (!host.has_gpu) {
        Result<Gpu, string> gpu = gpu_open();
        if (!gpu.ok) { _canvas_fail(host, gpu.error); return false; }
        host.gpu = gpu.value;
        host.has_gpu = true;
    }
    if (!host.has_surface) {
        Result<GpuSurface, string> surface = gpu_ui_surface(&host.gpu);
        if (!surface.ok) { _canvas_fail(host, surface.error); return false; }
        host.surface = surface.value;
        host.has_surface = true;
    }
    if (!host.has_canvas) {
        Result<Canvas, string> canvas = canvas_new(&host.gpu, host.surface.format);
        if (!canvas.ok) { _canvas_fail(host, canvas.error); return false; }
        host.canvas = canvas.value;
        host.has_canvas = true;
    }
    return true;
}

void _canvas_draw(*_CanvasHost host, Tick tick) {
    if (host.width == 0 || host.height == 0 || !_canvas_open(host)) { return; }
    Result<GpuFrame, string> frame = host.surface.frame();
    if (!frame.ok) {
        host.surface.configure(host.width, host.height);
        return;
    }
    host.canvas.begin(frame.value.view, host.width, host.height, host.scale, 0x00000000);
    host.draw(&host.canvas, tick);
    Result<int, string> sent = host.canvas.end();
    if (!sent.ok) { _canvas_fail(host, sent.error); }
    host.surface.present(&frame.value);
}
#endif

#ifdef __wasm__
// The view's <canvas>, `width` by `height` points at the window's scale.
void _canvas_draw(*_CanvasHost host, Tick tick) {
    if (host.width == 0 || host.height == 0) { return; }
    if (!host.has_canvas) {
        host.canvas = canvas_web_new(host.view);
        host.has_canvas = true;
    }
    uint32 pixel_width = (uint32)(host.width * host.scale + 0.5);
    uint32 pixel_height = (uint32)(host.height * host.scale + 0.5);
    host.canvas.begin(pixel_width, pixel_height, host.scale, 0x00000000);
    if (!host.canvas.drawing) { return; }
    host.draw(&host.canvas, tick);
    host.canvas.end();
}

int _canvas_next_view;
#endif

// A canvas drawn by `draw` once per display frame while `running`, and each time the view
// gets a new size.
void CanvasView(Style style, bool running, escaping fn(*Canvas, Tick)->void draw) {
    static int tag;
    *Slot slot = ui_slot(10, &tag);
    *_CanvasHost host = (*_CanvasHost)slot.data;
    if (host == null) {
        host = alloc<_CanvasHost>(1);
        slot.data = host;
        slot.dispose = void() {
#if defined(__ANDROID__) || defined(TARGET_OS_IPHONE)
            _canvas_drop_surface(host);
            if (host.has_gpu) { host.gpu.release(); }
#elif defined(__wasm__)
            if (host.has_canvas) { host.canvas.release(); }
#endif
            _canvas_release_draw(host.draw);
            free(host.error);
            free(host);
        };
    } else {
        _canvas_release_draw(host.draw);
    }
    host.draw = draw;
    Window window = ui_window();
    host.scale = window.scale > 0 ? window.scale / 100.0 : 1.0;
    use_gpu_surface(void(uint32 width, uint32 height) {
#if defined(__ANDROID__) || defined(TARGET_OS_IPHONE)
        if (width == 0 || height == 0) { _canvas_drop_surface(host); host.width = 0; host.height = 0; return; }
        if (host.has_surface && (width != host.width || height != host.height)) { host.surface.configure(width, height); }
        host.width = width;
        host.height = height;
        _canvas_draw(host, Tick{0, 0});
#endif
    });
#ifdef __wasm__
    if (host.view == 0) { host.view = ++_canvas_next_view; }
    use_frame(running, void(Tick tick) { _canvas_draw(host, tick); });
    // The element's size in points, from the layout; a new size draws again.
    ui_on_layout(void(Frame frame) {
        if ((uint32)frame.width == host.width && (uint32)frame.height == host.height) { return; }
        host.width = (uint32)frame.width;
        host.height = (uint32)frame.height;
        _canvas_draw(host, Tick{0, 0});
    });
    String id;
    defer String_free(&id);
    String_appendf(&id, "%d", host.view);
    ui_native_prop("id", id.data);
    NativeView(style, "canvas", void(string name, string payload) {});
#else
    use_frame(running, void(Tick tick) {
#if defined(__ANDROID__) || defined(TARGET_OS_IPHONE)
        _canvas_draw(host, tick);
#endif
    });
    GpuView(style);
#endif
}
